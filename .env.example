# MongoDB Atlas
# Exact name required: MONGODB_URI (also MONGODB_DB). Loaded by dotenv in scripts/setup-indexes.mjs.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=thabit

# Auth / cookies
JWT_ACCESS_SECRET=replace-with-at-least-32-random-chars!!
JWT_REFRESH_SECRET=replace-with-different-32-random-chars!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://thabit.vercel.app

# Quran Foundation — PRELIVE (used for local + Vercel preview)
QF_PRELIVE_CLIENT_ID=
QF_PRELIVE_CLIENT_SECRET=

# Quran Foundation — PRODUCTION (used only when VERCEL_ENV=production)
QF_PROD_CLIENT_ID=
QF_PROD_CLIENT_SECRET=

# Optional override: force production QF credentials outside Vercel prod
# QF_ENV=production

QURAN_TRANSLATION_ID=131
QURAN_CACHE_TTL_CHAPTERS=86400
QURAN_CACHE_TTL_VERSES=43200
QURAN_RATE_LIMIT_PER_WINDOW=60
QURAN_RATE_LIMIT_WINDOW_MS=60000

# AI (Gemini) — server-side only; never use VITE_ prefix
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_RATE_LIMIT_PER_HOUR=20
# Set > 0 to cache identical AI prompts in Mongo (seconds)
AI_CACHE_TTL_SECONDS=0

AUTH_RATE_LIMIT_PER_WINDOW=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

NODE_ENV=development
