# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=thabit

# Auth / JWT & Cookies
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-key
JWT_REFRESH_SECRET=replace-with-different-32-random-characters-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://thabit.vercel.app

# Quran Foundation API - Prelive (Development & Preview)
QF_PRELIVE_CLIENT_ID=your_prelive_client_id
QF_PRELIVE_CLIENT_SECRET=your_prelive_client_secret

# Quran Foundation API - Production (Vercel Production)
QF_PROD_CLIENT_ID=your_prod_client_id
QF_PROD_CLIENT_SECRET=your_prod_client_secret

# Optional Override: force QF mode ('development' or 'production')
QF_ENV=development

# Quran Caching & Rate Limits
QURAN_TRANSLATION_ID=20
QURAN_CACHE_TTL_CHAPTERS=86400
QURAN_CACHE_TTL_VERSES=43200
QURAN_RATE_LIMIT_PER_WINDOW=60
QURAN_RATE_LIMIT_WINDOW_MS=60000

# AI (Google Gemini) - Server-side only (never expose in client VITE_ vars)
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.1-flash-lite
AI_RATE_LIMIT_PER_HOUR=20
AI_CACHE_TTL_SECONDS=400

# Auth Rate Limiting
AUTH_RATE_LIMIT_PER_WINDOW=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Email (Resend) - password reset + Help & Support
# Sending address must be a verified domain/sender in Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Thaabit <onboarding@thabitquran.com>
# Inbox that receives Help & Support form messages (server)
SUPPORT_TO_EMAIL=support@thabitquran.com
# Shown on Help & Support query form (client)
VITE_SUPPORT_TO_EMAIL=support@thabitquran.com

# Node Environment
NODE_ENV=development
